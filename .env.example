# ─── App ──────────────────────────────────────────────
# Public URL of the site (no trailing slash)
APP_URL="https://weather.rakzu.xyz"
NEXTAUTH_URL="https://weather.rakzu.xyz"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# Comma-separated Google emails that get the admin panel
ADMIN_EMAILS="roshan.k.kaveri@gmail.com"

# ─── Database (PostgreSQL) ────────────────────────────
DATABASE_URL="postgresql://skycast:skycast_password@localhost:5432/skycast?schema=public"

# ─── Google sign-in (console.cloud.google.com → APIs & Services → Credentials) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=""
# Webhook signing secret from Resend → Webhooks (starts with whsec_)
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="SkyCast <weather@rakzu.xyz>"

# Optional fallback: any SMTP server (used only when RESEND_API_KEY is empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ─── SMS (textbee.dev Android gateway) ────────────────
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""
# Signing secret you set when creating the textbee webhook (min 20 chars)
TEXTBEE_WEBHOOK_SECRET=""

# ─── Misc ─────────────────────────────────────────────
# Contact shown to OpenStreetMap Nominatim in the User-Agent (their usage policy)
CONTACT_EMAIL="roshan.k.kaveri@gmail.com"
# Default timezone for new subscriptions
DEFAULT_TIMEZONE="Asia/Kolkata"
